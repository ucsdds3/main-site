# Copy to `.env` and fill in values. `.env` is gitignored.
#
# Supabase: enable exactly ONE URL + anon key pair (comment out the other).
# Option C: `npm run db:local` creates `.env.local` and overrides `.env` for Docker Supabase.

# --- DS3-dev (recommended) — project ref ngsciswixeaslnaspgsg ---
VITE_SUPABASE_URL=https://ngsciswixeaslnaspgsg.supabase.co
VITE_SUPABASE_ANON_KEY=your-ds3-dev-anon-key

